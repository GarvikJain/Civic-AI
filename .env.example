# CivicAI environment configuration
# Copy this file to ".env" and fill in your own values.
# The ".env" file is never committed to git.

# --- Application ---
APP_NAME=CivicAI
DEBUG=true

# --- Database ---
# SQLite is used for development. To move to PostgreSQL later, only this
# line needs to change, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civicai
DATABASE_URL=sqlite:///./data/civicai.db

# --- Authentication (JWT) ---
# Use a long random string in production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Backend URL used by the Streamlit frontend ---
BACKEND_URL=http://127.0.0.1:8000

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- AI module paths and models ---
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Tesseract OCR ---
# On Windows, set the full path to tesseract.exe, for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/macOS this can usually stay empty.
TESSERACT_CMD=
