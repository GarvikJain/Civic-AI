# CivicAI environment configuration
# Copy this file to ".env" and fill in your own values.
# The ".env" file is never committed to git.

# --- Application ---
APP_NAME=CivicAI
DEBUG=true

# --- Database ---
# SQLite is used for development. To move to PostgreSQL later, only this
# line needs to change, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civicai
DATABASE_URL=sqlite:///./data/civicai.db

# --- Authentication (JWT) ---
# Use a long random string in production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Backend URL used by the Streamlit frontend ---
BACKEND_URL=http://127.0.0.1:8000

# --- LLM (Groq) ---
GROQ_API_KEY=
# Groq retires models over time. If a query fails with "model not found",
# pick a current one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# --- AI module paths and models ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=civicai_regulations
REGULATIONS_DIR=./data/regulations
UPLOAD_DIR=./data/uploads
DOCUMENTS_DIR=./data/documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Regulation RAG tuning ---
# Chunk sizes are in characters.
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
# Candidates fetched from ChromaDB before reranking.
RAG_TOP_K=8
# Chunks kept after reranking and sent to the LLM.
RAG_RERANK_TOP_K=3
# Minimum cross-encoder score for a chunk to be treated as real evidence.
RAG_MIN_SCORE=0.0

# --- Tesseract OCR / document verification ---
# On Windows, set the full path to tesseract.exe, for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/macOS this can usually stay empty.
TESSERACT_CMD=
# Largest document a citizen may upload.
MAX_UPLOAD_SIZE_MB=10
# Below this many characters of OCR text, a document goes to officer review
# instead of being judged automatically.
OCR_MIN_TEXT_LENGTH=25

# Timezone for the physical office's business day. Queue depth, queue numbers,
# and prediction hour/weekday use this calendar. Database instants stay UTC.
# OFFICE_TIMEZONE=UTC
